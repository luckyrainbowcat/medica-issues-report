{
  "name": "issue-tracker-mvp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "ts-node-dev --respawn --transpile-only --project src/service-management-backend/tsconfig.json src/service-management-backend/server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\" --names \"NEXTJS,BACKEND\" --prefix-colors \"blue,green\"",
    "dev:network": "next dev -H 0.0.0.0",
    "dev:3001": "next dev -p 3001",
    "dev:3002": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.21.5",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "fabric": "^5.3.0",
    "firebase": "^12.7.0",
    "firebase-admin": "^13.6.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.0",
    "multer": "^2.0.2",
    "next": "^14.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.6",
